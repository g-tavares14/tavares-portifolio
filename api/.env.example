# Copie para api/.env e preencha. O .env nunca vai para o git.
# Sem uma integração preenchida, o card dela mostra "sem dados" / "Nada tocando".

# GitHub: mapa de contribuições e total do ano no card de telemetria.
# Token: https://github.com/settings/personal-access-tokens/new
#   (fine-grained, "Public repositories (read-only)", nenhuma permissão extra)
GITHUB_USERNAME=g-tavares14
GITHUB_TOKEN=

# Spotify: card do toca-discos.
# 1. https://developer.spotify.com/dashboard → Create app
#    Redirect URI: http://127.0.0.1:8888/callback   ·   API: Web API
# 2. Cole o Client ID e o Client Secret abaixo.
# 3. Dentro de api/, rode: go run ./cmd/spotify-auth  (preenche o refresh token sozinho)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
